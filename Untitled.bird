sig
  bpm 124
  system 12tet western
  scale C chromatic

arr
  main 32 |wtb

tracks
  1 Drums |ynu
    type midi
    plugin tivraDrumMachine
    strip tivraStrip
  2 Chords |zeq
    type midi
    plugin tivraFM
    strip tivraStrip
  3 Bass |bss
    type midi
    plugin tivra303
    strip tivraStrip
  4 Audio |xym
    type audio
    strip tivraStrip
  5 MIDI |grn
    type midi
    strip tivraStrip

returns
  0 Hall |rmj
    fx tivraHall
    strip tivraStrip
  1 Plate |rxa
    fx tivraPlate
    strip tivraStrip
  2 Delay |rvv
    fx tivraDelay
    strip tivraStrip
  3 Color |rkm
    fx tivraDistortion
    strip tivraStrip

sec main
  trk 1 Drums |ynu
    c 0:0 32:0 |eddx
  trk 2 Chords |zeq
    c 0:0 32:0 |inxn
  trk 3 Bass |bss
    c 0:0 32:0 |qnxh
